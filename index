<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Kitty Explains</title>

  <style>
    *{box-sizing:border-box}

    body{
      margin:0;
      font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial;
      background:#fafafa;
      color:#111;
    }

    header{
      position:sticky;
      top:0;
      background:rgba(255,255,255,.8);
      backdrop-filter:blur(10px);
      border-bottom:1px solid rgba(0,0,0,.06);
      z-index:10;
    }

    .bar{
      max-width:900px;
      margin:0 auto;
      padding:12px 16px;
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:12px;
    }

    .controls{
      display:flex;
      gap:8px;
      align-items:center;
    }

    button{
      border:1px solid rgba(0,0,0,.15);
      background:white;
      border-radius:999px;
      padding:8px 12px;
      font-weight:600;
      cursor:pointer;
    }

    main{
      max-width:900px;
      margin:0 auto;
      padding:20px 16px;
    }

    .stage{
      background:white;
      border-radius:18px;
      box-shadow:0 10px 30px rgba(0,0,0,.08);
      overflow:hidden;
    }

    /* 9:16 */
    .viewport{
      width:100%;
      aspect-ratio:9/16;
      position:relative;
      background:white;
    }

    .slide{
      position:absolute;
      inset:0;
      opacity:0;
      transition:.25s ease;
      display:flex;
      align-items:center;
      justify-content:center;
    }

    .slide.active{
      opacity:1;
      z-index:2;
    }

    .slide img{
      width:100%;
      height:100%;
      object-fit:contain;
      background:white;
    }

    .dots{
      display:flex;
      justify-content:center;
      gap:8px;
      padding:12px;
      border-top:1px solid rgba(0,0,0,.06);
    }

    .dot{
      width:10px;
      height:10px;
      border-radius:50%;
      border:1px solid #999;
      background:white;
      cursor:pointer;
    }

    .dot.active{
      background:#111;
      border-color:#111;
    }
  </style>
</head>
<body>

<header>
  <div class="bar">
    <strong>Kitty Explains 🐱</strong>

    <div class="controls">
      <button id="prevBtn">←</button>
      <span id="counter">1 / 9</span>
      <button id="nextBtn">→</button>
    </div>
  </div>
</header>

<main>
  <div class="stage">
    <div class="viewport" id="viewport"></div>
    <div class="dots" id="dots"></div>
  </div>
</main>

<script>
  // 🔥 Auto-load assets/1.png … 9.png
  const slides = Array.from({length:9}, (_,i)=>({
    id:i+1,
    src:`assets/${i+1}.png`
  }));

  const viewport = document.getElementById("viewport");
  const dots = document.getElementById("dots");
  const counter = document.getElementById("counter");

  let current = 0;

  function render(){
    viewport.innerHTML="";
    dots.innerHTML="";

    slides.forEach((s,i)=>{
      const slide = document.createElement("div");
      slide.className="slide"+(i===current?" active":"");

      const img=document.createElement("img");
      img.src=s.src;
      img.alt=`Slide ${s.id}`;

      img.onerror=()=>{
        img.src="data:image/svg+xml;charset=utf-8,"+encodeURIComponent(`
          <svg xmlns="http://www.w3.org/2000/svg" width="900" height="1600">
            <rect width="100%" height="100%" fill="#ffffff"/>
            <text x="50%" y="50%" text-anchor="middle"
              font-family="Arial" font-size="40" fill="#999">
              Missing: assets/${s.id}.png
            </text>
          </svg>
        `);
      };

      slide.appendChild(img);
      viewport.appendChild(slide);

      const dot=document.createElement("button");
      dot.className="dot"+(i===current?" active":"");
      dot.onclick=()=>go(i);
      dots.appendChild(dot);
    });

    counter.textContent=`${current+1} / ${slides.length}`;
  }

  function go(i){
    current=(i+slides.length)%slides.length;
    render();
  }

  document.getElementById("nextBtn").onclick=()=>go(current+1);
  document.getElementById("prevBtn").onclick=()=>go(current-1);

  // keyboard
  window.addEventListener("keydown",e=>{
    if(e.key==="ArrowRight") go(current+1);
    if(e.key==="ArrowLeft") go(current-1);
  });

  // swipe mobile
  let startX=null;
  viewport.addEventListener("touchstart",e=>{
    startX=e.touches[0].clientX;
  },{passive:true});

  viewport.addEventListener("touchend",e=>{
    if(startX==null) return;
    const dx=e.changedTouches[0].clientX-startX;
    if(Math.abs(dx)>40){
      dx<0?go(current+1):go(current-1);
    }
    startX=null;
  });

  render();
</script>

</body>
</html>
